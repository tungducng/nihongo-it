# === Service URLs (defaults match local stack) ===
E2E_GATEWAY_URL=http://localhost:8080
E2E_USER_APP_URL=http://localhost:3000
E2E_ADMIN_APP_URL=http://localhost:3001

# === DB connection (matches docker/.env) ===
E2E_DB_HOST=localhost
E2E_DB_PORT=5433
E2E_DB_USER=postgres
E2E_DB_PASSWORD=NihongoIT2024!
E2E_USER_SERVICE_DB=user_service
E2E_LEARNING_SERVICE_DB=learning_service
